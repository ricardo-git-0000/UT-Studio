<UserControl x:Class="UTStudio.ScanVisualization.AScan.Wpf.AScanView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:UTStudio.Visualization.Wpf.Controls;assembly=UTStudio.Visualization.Wpf"
    Focusable="True" AutomationProperties.Name="Componente A-Scan"
    KeyboardNavigation.TabNavigation="Local">
  <UserControl.Resources>
    <Style TargetType="ComboBoxItem">
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
  </UserControl.Resources>
  <UserControl.InputBindings>
    <KeyBinding Key="Home" Command="{Binding ResetViewportCommand, ElementName=Root}" />
    <KeyBinding Key="Add" Command="{Binding ZoomInCommand, ElementName=Root}" />
    <KeyBinding Key="Subtract" Command="{Binding ZoomOutCommand, ElementName=Root}" />
    <KeyBinding Key="Left" Modifiers="Alt" Command="{Binding PanLeftCommand, ElementName=Root}" />
    <KeyBinding Key="Right" Modifiers="Alt" Command="{Binding PanRightCommand, ElementName=Root}" />
  </UserControl.InputBindings>
  <Grid x:Name="Root" DataContext="{x:Null}">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Orientation="Horizontal" Margin="0,0,0,12" AutomationProperties.Name="Herramientas A-Scan">
      <TextBlock Text="{Binding ComponentPhase}" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,12,0" AutomationProperties.LiveSetting="Polite"/>
      <Button Content="Cursores" Command="{Binding ToggleCursorsCommand}" MinWidth="90" Padding="16,8" Margin="0,0,8,0" AutomationProperties.HelpText="Muestra u oculta los cursores A y B"/>
      <Button Content="Restablecer" Command="{Binding ResetCursorsCommand}" MinWidth="100" Padding="16,8" Margin="0,0,8,0" AutomationProperties.HelpText="Restablece cursores y medidas"/>
      <Button Content="Restablecer zoom" Command="{Binding ResetViewportCommand}" Padding="16,8" Margin="0,0,8,0" AutomationProperties.HelpText="Atajo Home"/>
      <Button Content="Live" Command="{Binding ReturnToLiveCommand}" Padding="12,8"/>
      <Separator Margin="8,0"/>
      <Button Content="Editar gates" Command="{Binding GateEditor.BeginEditCommand}" Padding="12,8" Margin="0,0,8,0"
              AutomationProperties.HelpText="Comienza una edición local del plan de gates"/>
      <Button Content="Preview" Command="{Binding GateEditor.PreviewCommand}" Padding="12,8" Margin="0,0,8,0"
              AutomationProperties.HelpText="Valida y muestra el Preview sin aplicar cambios"/>
      <Button Content="Cancelar" Command="{Binding GateEditor.CancelCommand}" Padding="12,8" Margin="0,0,8,0"
              AutomationProperties.HelpText="Cancela únicamente la edición local"/>
      <Button Content="Aplicar" Command="{Binding GateEditor.ApplyCommand}" Padding="12,8" Margin="0,0,8,0"
              AutomationProperties.HelpText="Aplica explícitamente el Preview confirmado"/>
      <TextBlock Text="{Binding GateEditor.State.Phase}" Margin="8,0,0,0" VerticalAlignment="Center"
                 AutomationProperties.Name="Estado del editor de gates" AutomationProperties.LiveSetting="Polite"/>
    </StackPanel>
    <WrapPanel x:Name="GateEditorPanel" Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10"
                AutomationProperties.Name="Valores de la puerta seleccionada">
      <WrapPanel.Style>
        <Style TargetType="WrapPanel">
          <Setter Property="Visibility" Value="Visible"/>
          <Style.Triggers>
            <DataTrigger Binding="{Binding GateEditor.SelectedGateId}" Value="{x:Null}">
              <Setter Property="Visibility" Value="Collapsed"/>
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </WrapPanel.Style>
      <TextBlock Text="Puerta: " VerticalAlignment="Center" FontWeight="SemiBold"/>
      <ComboBox x:Name="GateSelector" Width="100" Margin="0,0,10,0" ItemsSource="{Binding GateEditor.GateIds}"
                IsEnabled="{Binding GateEditor.IsDefinitionEditingEnabled}"
                SelectedItem="{Binding GateEditor.SelectedGateId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                AutomationProperties.Name="Puerta seleccionada"/>
      <TextBlock Text="Detector:" VerticalAlignment="Center"/>
      <ComboBox x:Name="GateDetectorSelector" Width="190" Margin="6,0,10,0" ItemsSource="{Binding GateEditor.DetectorChoices}"
                IsEnabled="{Binding GateEditor.IsDefinitionEditingEnabled}"
                DisplayMemberPath="Label" SelectedValuePath="Value"
                SelectedValue="{Binding GateEditor.SelectedGateDetector, Mode=TwoWay}"
                AutomationProperties.Name="Detector de la puerta"/>
      <TextBlock Text="Referencia:" VerticalAlignment="Center"/>
      <ComboBox x:Name="GateReferenceSelector" Width="145" Margin="6,0,10,0" ItemsSource="{Binding GateEditor.ReferenceChoices}"
                IsEnabled="{Binding GateEditor.IsDefinitionEditingEnabled}"
                DisplayMemberPath="Label" SelectedValuePath="Value"
                SelectedValue="{Binding GateEditor.SelectedGateReference, Mode=TwoWay}"
                AutomationProperties.Name="Referencia temporal"/>
      <TextBlock Text="{Binding GateEditor.SelectedGateReferenceLabel}" VerticalAlignment="Center" Margin="0,0,16,0"/>
      <TextBlock Text="{Binding GateEditor.SelectedGateStartLabel}" VerticalAlignment="Center"/>
      <StackPanel Margin="6,0,14,0">
        <TextBox x:Name="GateStartValue" Width="92" VerticalContentAlignment="Center"
                 Tag="Start" TextChanged="OnGateNumericTextChanged" LostKeyboardFocus="OnGateNumericLostKeyboardFocus"
                 AutomationProperties.Name="{Binding GateEditor.SelectedGateStartLabel}"
                 AutomationProperties.HelpText="Al salir del campo valida y genera el mismo Preview que el arrastre"/>
        <TextBlock x:Name="GateStartValidation" Foreground="#FFB4AB" Visibility="Collapsed"
                   AutomationProperties.LiveSetting="Assertive"/>
      </StackPanel>
      <TextBlock Text="{Binding GateEditor.SelectedGateEndLabel}" VerticalAlignment="Center"/>
      <StackPanel Margin="6,0,14,0">
        <TextBox x:Name="GateEndValue" Width="92" VerticalContentAlignment="Center"
                 Tag="End" TextChanged="OnGateNumericTextChanged" LostKeyboardFocus="OnGateNumericLostKeyboardFocus"
                 AutomationProperties.Name="{Binding GateEditor.SelectedGateEndLabel}"
                 AutomationProperties.HelpText="Al salir del campo valida y genera el mismo Preview que el arrastre"/>
        <TextBlock x:Name="GateEndValidation" Foreground="#FFB4AB" Visibility="Collapsed"
                   AutomationProperties.LiveSetting="Assertive"/>
      </StackPanel>
      <StackPanel x:Name="GateThresholdPanel" Orientation="Horizontal">
        <StackPanel.Style>
          <Style TargetType="StackPanel">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
              <DataTrigger Binding="{Binding GateEditor.SelectedGateHasThreshold}" Value="True">
                <Setter Property="Visibility" Value="Visible"/>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </StackPanel.Style>
        <TextBlock Text="Umbral (%):" VerticalAlignment="Center"/>
        <StackPanel Margin="6,0,14,0">
          <TextBox x:Name="GateThresholdValue" Width="80" VerticalContentAlignment="Center"
                   Tag="Threshold" TextChanged="OnGateNumericTextChanged" LostKeyboardFocus="OnGateNumericLostKeyboardFocus"
                   AutomationProperties.Name="Umbral de puerta en porcentaje"
                   AutomationProperties.HelpText="Al salir del campo valida y genera el mismo Preview que el handle gráfico"/>
          <TextBlock x:Name="GateThresholdValidation" Foreground="#FFB4AB" Visibility="Collapsed"
                     AutomationProperties.LiveSetting="Assertive"/>
        </StackPanel>
        <TextBlock Text="=" VerticalAlignment="Center"/>
        <TextBlock Text="{Binding GateEditor.SelectedGateThresholdCounts, StringFormat={}{0:0.###} counts}"
                   VerticalAlignment="Center" Margin="4,0,12,0"
                   AutomationProperties.Name="Equivalencia de umbral en counts"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal">
        <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/>
          <Style.Triggers><DataTrigger Binding="{Binding GateEditor.SelectedGateHasLocalParameters}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
        </Style></StackPanel.Style>
        <TextBlock Text="Radio (muestras):" VerticalAlignment="Center"/>
        <TextBox x:Name="GateRadiusValue" Width="52" Margin="6,0,10,0" Tag="Radius"
                 IsEnabled="{Binding GateEditor.IsDefinitionEditingEnabled}"
                 LostKeyboardFocus="OnGateParameterLostKeyboardFocus" AutomationProperties.Name="Radio de vecindad en muestras"
                 AutomationProperties.HelpText="{Binding GateEditor.DefinitionValidationMessage, TargetNullValue=''}"/>
        <TextBlock x:Name="GateRadiusValidation" Foreground="#FFB4AB" Visibility="Collapsed"
                   AutomationProperties.LiveSetting="Assertive"/>
        <TextBlock Text="Prominencia (counts):" VerticalAlignment="Center"/>
        <TextBox x:Name="GateProminenceValue" Width="70" Margin="6,0,10,0" Tag="Prominence"
                 IsEnabled="{Binding GateEditor.IsDefinitionEditingEnabled}"
                 LostKeyboardFocus="OnGateParameterLostKeyboardFocus" AutomationProperties.Name="Prominencia mínima en counts"
                 AutomationProperties.HelpText="{Binding GateEditor.DefinitionValidationMessage, TargetNullValue=''}"/>
        <TextBlock x:Name="GateProminenceValidation" Foreground="#FFB4AB" Visibility="Collapsed"
                   AutomationProperties.LiveSetting="Assertive"/>
        <TextBlock Text="Distancia (muestras):" VerticalAlignment="Center"/>
        <TextBox x:Name="GateDistanceValue" Width="52" Margin="6,0,10,0" Tag="Distance"
                 IsEnabled="{Binding GateEditor.IsDefinitionEditingEnabled}"
                 LostKeyboardFocus="OnGateParameterLostKeyboardFocus" AutomationProperties.Name="Distancia mínima en muestras"
                 AutomationProperties.HelpText="{Binding GateEditor.DefinitionValidationMessage, TargetNullValue=''}"/>
        <TextBlock x:Name="GateDistanceValidation" Foreground="#FFB4AB" Visibility="Collapsed"
                   AutomationProperties.LiveSetting="Assertive"/>
        <TextBlock Text="Meseta: LowerCenter" VerticalAlignment="Center"/>
      </StackPanel>
      <TextBlock Text="{Binding GateEditor.DefinitionValidationMessage}" Foreground="#FFB4AB"
                 VerticalAlignment="Center" AutomationProperties.LiveSetting="Assertive"/>
      <TextBlock Text="{Binding GateEditor.SelectedGateHysteresisDescription}" Foreground="#FFD18A"
                 VerticalAlignment="Center" AutomationProperties.Name="Configuración de histéresis"
                 AutomationProperties.LiveSetting="Polite"/>
      <!-- Keep the result cells at a stable width.  Starting a graphical Preview temporarily replaces the
           exact result; allowing these strings to resize the wrapping panel also resized the plot and
           invalidated the just-acquired gate pointer transform. -->
      <TextBlock x:Name="GateResolvedWindow" Width="220" TextTrimming="CharacterEllipsis"
                 Text="{Binding GateEditor.SelectedGateResolvedWindow}" ToolTip="{Binding GateEditor.SelectedGateResolvedWindow}"
                 Margin="12,0,0,0" VerticalAlignment="Center"/>
      <TextBlock x:Name="GateResolutionStatus" Width="130" TextTrimming="CharacterEllipsis"
                 Text="{Binding GateEditor.SelectedGateResolutionStatus}" ToolTip="{Binding GateEditor.SelectedGateResolutionStatus}"
                 Margin="12,0,0,0" VerticalAlignment="Center"/>
      <TextBlock x:Name="GateExactEvent" Width="430" TextTrimming="CharacterEllipsis"
                 Text="{Binding GateEditor.SelectedGateExactEvent}" ToolTip="{Binding GateEditor.SelectedGateExactEvent}"
                 Margin="12,0,0,0" VerticalAlignment="Center"
                 AutomationProperties.Name="Evento exacto de la puerta" AutomationProperties.LiveSetting="Polite"/>
      <TextBlock Text="{Binding GateEditor.NumericValidationMessage}" Foreground="#FFB4AB"
                 VerticalAlignment="Center" AutomationProperties.LiveSetting="Assertive"/>
    </WrapPanel>
    <controls:AScanControl x:Name="Scan" Grid.Row="2" AutomationProperties.Name="Gráfico A-Scan"
      CursorActivated="OnCursorActivated" CursorMoveRequested="OnCursorMoveRequested"
      GateBeginWindowCaptureRequested="OnGateBeginWindowCaptureRequested"
      TimeZoomRequested="OnTimeZoomRequested" TimePanRequested="OnTimePanRequested" TimeResetRequested="OnTimeResetRequested"/>
    <StackPanel Grid.Row="3" Margin="0,12,0,0">
      <TextBlock Text="Zoom temporal: rueda sobre el gráfico · desplazar: botón central o Mayús + arrastre izquierdo." Foreground="#AEBFD4"/>
      <StackPanel Orientation="Horizontal" AutomationProperties.Name="Rango visible A-Scan">
        <TextBlock Text="Vista: " FontWeight="SemiBold"/><TextBlock Text="{Binding TimeViewport.VisibleMinimumSeconds, StringFormat={}{0:0.#########} s, TargetNullValue=—}"/>
        <TextBlock Text=" – "/><TextBlock Text="{Binding TimeViewport.VisibleMaximumSeconds, StringFormat={}{0:0.#########} s, TargetNullValue=—}"/>
        <TextBlock Text="   RF: −100…+100 %   Zoom: "/><TextBlock Text="{Binding TimeViewport.ZoomFactor, StringFormat={}{0:0.##}×, TargetNullValue=—}"/>
      </StackPanel>
      <TextBlock Text="Medida manual aproximada sobre los puntos visuales reducidos; no representa precisión de muestra original." Foreground="#AEBFD4"/>
      <StackPanel Orientation="Horizontal" AutomationProperties.Name="Medidas de cursores A-Scan">
        <TextBlock Text="A: " FontWeight="SemiBold"/><TextBlock Text="{Binding Cursors.A.TimeMicroseconds, StringFormat={}{0:0.###} µs, TargetNullValue=—}"/><TextBlock Text=" / "/><TextBlock Text="{Binding Cursors.A.AmplitudePercent, StringFormat={}{0:+0.##;-0.##;0} %, TargetNullValue=—}"/>
        <TextBlock Text="   B: " FontWeight="SemiBold" Margin="20,0,0,0"/><TextBlock Text="{Binding Cursors.B.TimeMicroseconds, StringFormat={}{0:0.###} µs, TargetNullValue=—}"/><TextBlock Text=" / "/><TextBlock Text="{Binding Cursors.B.AmplitudePercent, StringFormat={}{0:+0.##;-0.##;0} %, TargetNullValue=—}"/>
        <TextBlock Text="   Δt: " FontWeight="SemiBold" Margin="20,0,0,0"/><TextBlock Text="{Binding Cursors.DeltaTimeMicroseconds, StringFormat={}{0:+0.###;-0.###;0} µs, TargetNullValue=—}"/>
        <TextBlock Text="   ΔRF: " FontWeight="SemiBold" Margin="20,0,0,0"/><TextBlock Text="{Binding Cursors.DeltaAmplitudePercent, StringFormat={}{0:+0.##;-0.##;0} %, TargetNullValue=—}"/>
      </StackPanel>
      <TextBlock Text="{Binding Error.Message}" Foreground="#FFB4AB" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
      <TextBlock x:Name="VisualErrorText" Text="{Binding VisualError.Message}" Foreground="#FFD18A" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
      <TextBlock Text="{Binding NotificationError.Message}" Foreground="#FFD18A" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
    </StackPanel>
  </Grid>
</UserControl>
