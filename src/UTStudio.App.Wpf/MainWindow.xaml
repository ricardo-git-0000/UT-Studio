<Window x:Class="UTStudio.App.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:UTStudio.Visualization.Wpf.Controls;assembly=UTStudio.Visualization.Wpf"
        Title="UT-Studio · A-Scan simulado" Height="680" Width="1100" MinHeight="420" MinWidth="640"
        Background="#152235" Foreground="#E6EDF6">
    <Window.InputBindings>
        <KeyBinding Key="Home" Command="{Binding ResetViewportCommand}" />
        <KeyBinding Key="Add" Command="{Binding ZoomInCommand}" />
        <KeyBinding Key="Subtract" Command="{Binding ZoomOutCommand}" />
        <KeyBinding Key="Left" Modifiers="Alt" Command="{Binding PanLeftCommand}" />
        <KeyBinding Key="Right" Modifiers="Alt" Command="{Binding PanRightCommand}" />
    </Window.InputBindings>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="UT-Studio" FontSize="26" FontWeight="SemiBold" />
                <TextBlock Text="A-Scan convencional · RF bipolar · 2.048 muestras · 50 MHz" Foreground="#AEBFD4" Margin="0,4,0,0" />
            </StackPanel>
            <StackPanel x:Name="Interactions" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cursores" Command="{Binding ToggleCursorsCommand}" MinWidth="90" Padding="16,8" Margin="16,0,8,0" />
                <Button Content="Restablecer" Command="{Binding ResetCursorsCommand}" MinWidth="100" Padding="16,8" Margin="0,0,8,0" />
                <Button Content="Restablecer zoom" Command="{Binding ResetViewportCommand}" MinWidth="125" Padding="16,8" Margin="0,0,8,0"
                        AutomationProperties.HelpText="Restablece el rango temporal visible; atajo Home" />
                <Button Content="Start" Command="{Binding StartCommand}" MinWidth="90" Padding="16,8" Margin="0,0,8,0" />
                <Button Content="Stop" Command="{Binding StopCommand}" MinWidth="90" Padding="16,8" />
            </StackPanel>
        </DockPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="Sesión: " />
            <TextBlock Text="{Binding Session.Phase}" FontWeight="SemiBold" />
            <TextBlock Text="   Secuencia: " Margin="20,0,0,0" />
            <TextBlock Text="{Binding AScan.Sequence, TargetNullValue=—}" />
            <TextBlock Text="   Canal: " Margin="20,0,0,0" />
            <TextBlock Text="{Binding Metadata.Configuration.PhysicalChannelId.Value, TargetNullValue=—}" />
        </StackPanel>
        <controls:AScanControl x:Name="Scan" Grid.Row="2" Snapshot="{Binding AScan}" CursorState="{Binding Cursors}"
                               ViewportBinding="{Binding ViewportBinding}" CursorActivated="OnCursorActivated"
                               CursorMoveRequested="OnCursorMoveRequested" TimeZoomRequested="OnTimeZoomRequested"
                               TimePanRequested="OnTimePanRequested" TimeResetRequested="OnTimeResetRequested" />
        <StackPanel Grid.Row="3" Margin="0,12,0,0">
            <TextBlock Text="Zoom temporal: rueda sobre el gráfico · desplazar: botón central o Mayús + arrastre izquierdo." Foreground="#AEBFD4" />
            <StackPanel Orientation="Horizontal" AutomationProperties.Name="Rango visible A-Scan">
                <TextBlock Text="Vista: " FontWeight="SemiBold" />
                <TextBlock Text="{Binding TimeViewport.VisibleMinimumSeconds, StringFormat={}{0:0.#########} s, TargetNullValue=—}" />
                <TextBlock Text=" – " />
                <TextBlock Text="{Binding TimeViewport.VisibleMaximumSeconds, StringFormat={}{0:0.#########} s, TargetNullValue=—}" />
                <TextBlock Text="   RF: −100…+100 %" />
                <TextBlock Text="   Zoom: " />
                <TextBlock Text="{Binding TimeViewport.ZoomFactor, StringFormat={}{0:0.##}×, TargetNullValue=—}" />
            </StackPanel>
            <TextBlock Text="Medida manual aproximada sobre los puntos visuales reducidos; no representa precisión de muestra original." Foreground="#AEBFD4" />
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="A: " FontWeight="SemiBold" />
                <TextBlock Text="{Binding Cursors.A.TimeMicroseconds, StringFormat={}{0:0.###} µs, TargetNullValue=—}" />
                <TextBlock Text=" / " />
                <TextBlock Text="{Binding Cursors.A.AmplitudePercent, StringFormat={}{0:+0.##;-0.##;0} %, TargetNullValue=—}" />
                <TextBlock Text="   B: " FontWeight="SemiBold" Margin="20,0,0,0" />
                <TextBlock Text="{Binding Cursors.B.TimeMicroseconds, StringFormat={}{0:0.###} µs, TargetNullValue=—}" />
                <TextBlock Text=" / " />
                <TextBlock Text="{Binding Cursors.B.AmplitudePercent, StringFormat={}{0:+0.##;-0.##;0} %, TargetNullValue=—}" />
                <TextBlock Text="   Δt: " FontWeight="SemiBold" Margin="20,0,0,0" />
                <TextBlock Text="{Binding Cursors.DeltaTimeMicroseconds, StringFormat={}{0:+0.###;-0.###;0} µs, TargetNullValue=—}" />
                <TextBlock Text="   ΔRF: " FontWeight="SemiBold" Margin="20,0,0,0" />
                <TextBlock Text="{Binding Cursors.DeltaAmplitudePercent, StringFormat={}{0:+0.##;-0.##;0} %, TargetNullValue=—}" />
            </StackPanel>
            <TextBlock x:Name="MetricsText" Text="Visual · recibidos: 0 · publicados: 0 · sustituidos: 0" />
            <TextBlock Text="{Binding Error.Message}" Foreground="#FFB4AB" TextWrapping="Wrap" />
            <TextBlock x:Name="VisualErrorText" Text="{Binding VisualError.Message}" Foreground="#FFD18A" TextWrapping="Wrap" />
            <TextBlock Text="{Binding NotificationError.Message}" Foreground="#FFD18A" TextWrapping="Wrap" />
        </StackPanel>
        <TextBlock x:Name="ShutdownText" Grid.Row="4" Margin="0,8,0,0" Foreground="#FFD18A" TextWrapping="Wrap" />
    </Grid>
</Window>
