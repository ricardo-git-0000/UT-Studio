    <InternalsVisibleTo Include="UTStudio.Tests.Wpf" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../UTStudio.Domain/UTStudio.Domain.csproj" />
    <ProjectReference Include="../UTStudio.Contracts/UTStudio.Contracts.csproj" />
    <ProjectReference Include="../UTStudio.Application/UTStudio.Application.csproj" />
    <ProjectReference Include="../UTStudio.Acquisition.Simulator/UTStudio.Acquisition.Simulator.csproj" />
    <ProjectReference Include="../UTStudio.Visualization.Core/UTStudio.Visualization.Core.csproj" />
    <ProjectReference Include="../UTStudio.Visualization.Wpf/UTStudio.Visualization.Wpf.csproj" />
    <ProjectReference Include="../UTStudio.Presentation/UTStudio.Presentation.csproj" />
  </ItemGroup>
</Project>
