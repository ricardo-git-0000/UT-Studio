<Window x:Class="UTStudio.App.Wpf.BScanWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:UTStudio.Visualization.Wpf.Controls;assembly=UTStudio.Visualization.Wpf"
        xmlns:adapters="clr-namespace:UTStudio.App.Wpf.Adapters"
        Title="UT-Studio · B-Scan" Width="1000" Height="700" MinWidth="480" MinHeight="360"
        Background="#0B1220" Foreground="#CDD9E8">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    <adapters:BScanResamplingModeConverter x:Key="BScanResamplingModeConverter" />
  </Window.Resources>
  <Window.InputBindings>
    <KeyBinding Key="Home" Command="{Binding ResetAllCommand}" />
    <KeyBinding Key="Add" Command="{Binding ZoomTimeInCommand}" />
    <KeyBinding Key="Subtract" Command="{Binding ZoomTimeOutCommand}" />
    <KeyBinding Key="Left" Modifiers="Alt" Command="{Binding PanSpatialLeftCommand}" />
    <KeyBinding Key="Right" Modifiers="Alt" Command="{Binding PanSpatialRightCommand}" />
    <KeyBinding Key="Up" Modifiers="Alt" Command="{Binding PanTimeUpCommand}" />
    <KeyBinding Key="Down" Modifiers="Alt" Command="{Binding PanTimeDownCommand}" />
  </Window.InputBindings>
  <DockPanel Margin="16">
    <WrapPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
      <Button Content="Tiempo +" Command="{Binding ZoomTimeInCommand}" Margin="0,0,6,0" />
      <Button Content="Tiempo −" Command="{Binding ZoomTimeOutCommand}" Margin="0,0,6,0" />
      <Button Content="Espacio +" Command="{Binding ZoomSpatialInCommand}" Margin="0,0,6,0" />
      <Button Content="Espacio −" Command="{Binding ZoomSpatialOutCommand}" Margin="0,0,6,0" />
      <Button Content="Tamaño B -" Command="{Binding DecreaseLiveWindowCommand}" Margin="0,0,6,0"
              AutomationProperties.Name="Reducir número de trazas visibles B-Scan" />
      <TextBlock Text="{Binding LiveWindowColumns, StringFormat={}{0} trazas}" VerticalAlignment="Center"
                 Margin="0,0,6,0" AutomationProperties.Name="Tamaño visible B-Scan" />
      <Button Content="Tamaño B +" Command="{Binding IncreaseLiveWindowCommand}" Margin="0,0,6,0"
              AutomationProperties.Name="Aumentar número de trazas visibles B-Scan" />
      <Button Content="Cargar paleta" Click="OnLoadPalette" Margin="0,0,6,0"
              AutomationProperties.Name="Cargar paleta de colores B-Scan desde archivo" />
      <Button Content="Restablecer" Command="{Binding ResetAllCommand}" Margin="0,0,12,0" />
      <TextBlock Text="Remuestreo:" VerticalAlignment="Center" Margin="0,0,4,0" />
      <ComboBox x:Name="ResamplingSelector" Width="190" Margin="0,0,10,0"
                SelectionChanged="OnResamplingSelectionChanged" IsTextSearchEnabled="True"
                AutomationProperties.Name="Modo de remuestreo B-Scan"
                ToolTip="Bilineal y bicúbica se recomiendan para interacción. Lanczos-3 ofrece alta calidad con cadencia reducida."
                AutomationProperties.HelpText="Bilineal y bicúbica se recomiendan para interacción. Lanczos-3 ofrece alta calidad con cadencia reducida." />
      <TextBlock Text="{Binding State.Phase}" VerticalAlignment="Center" />
    </WrapPanel>
    <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0" AutomationProperties.Name="Estado B-Scan">
      <TextBlock x:Name="PaletteStatus" Text="Paleta: predeterminada" />
      <TextBlock><Run Text="Solicitado: "/><Run Text="{Binding State.RequestedResamplingMode, Converter={StaticResource BScanResamplingModeConverter}, Mode=OneWay}" /></TextBlock>
      <TextBlock Text="Actualizando…" Visibility="{Binding State.IsRenderPending, Converter={StaticResource BooleanToVisibilityConverter}}" />
      <TextBlock><Run Text="Presentado: "/><Run Text="{Binding State.PresentedResamplingMode, Converter={StaticResource BScanResamplingModeConverter}, Mode=OneWay}" /></TextBlock>
      <TextBlock x:Name="LanczosWarning" Text="Alta calidad; la actualización puede ser más lenta" Visibility="Collapsed" />
      <TextBlock Text="{Binding State.Diagnostics.ColumnsAccepted, StringFormat=Aceptadas: {0}}" />
      <TextBlock Text="{Binding State.Diagnostics.ColumnsRejectedPinnedSlot, StringFormat=Rechazadas por slot fijado: {0}}" />
      <TextBlock Text="{Binding State.Diagnostics.ColumnsEvicted, StringFormat=Reemplazadas: {0}}" />
      <TextBlock Text="{Binding State.Selection.Residency, StringFormat=Selección: {0}, TargetNullValue=Selección: ninguna}" />
      <TextBlock Foreground="#FFD18A" Text="{Binding State.SelectionError}" />
      <TextBlock Foreground="#FFD18A" Text="{Binding State.BScanVisualError}" />
      <TextBlock Foreground="#FFD18A" Text="{Binding State.BScanIngressError}" />
      <TextBlock Foreground="#FFD18A" Text="{Binding State.UiInteractionError}" />
      <TextBlock Foreground="#FFD18A" Text="{Binding State.PersistenceError}" />
      <TextBlock Foreground="#FFD18A" Text="{Binding State.ConfigurationError}" />
    </StackPanel>
    <controls:BScanControl x:Name="Scan" AutomationProperties.Name="B-Scan en vivo"
                           AutomationProperties.HelpText="Rueda: tiempo; Control y rueda: espacio; Mayúsculas y arrastre: desplazar; Home: restablecer" />
  </DockPanel>
</Window>
