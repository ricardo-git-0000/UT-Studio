<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net10.0;net10.0-windows</TargetFrameworks>
    <UseWPF Condition="'$(TargetFramework)' == 'net10.0-windows'">true</UseWPF>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Optimize>true</Optimize>
    <AllowUnsafeBlocks Condition="'$(TargetFramework)' == 'net10.0-windows'">true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <!-- Approved for this project only. Stable 0.15.8 targets .NET 6+ and supports net10.0;
         it provides isolated jobs, statistical output and the built-in MemoryDiagnoser. -->
    <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/UTStudio.Domain/UTStudio.Domain.csproj" />
    <ProjectReference Include="../../src/UTStudio.Contracts/UTStudio.Contracts.csproj" />
    <ProjectReference Include="../../src/UTStudio.Acquisition.Simulator/UTStudio.Acquisition.Simulator.csproj" />
    <ProjectReference Include="../../src/UTStudio.Visualization.Core/UTStudio.Visualization.Core.csproj" />
    <ProjectReference Include="../../src/UTStudio.Inspection.Core/UTStudio.Inspection.Core.csproj" />
    <ProjectReference Include="../../src/UTStudio.Visualization.Wpf/UTStudio.Visualization.Wpf.csproj"
                      Condition="'$(TargetFramework)' == 'net10.0-windows'" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <Compile Remove="BScanWpfBenchmarks.cs" />
  </ItemGroup>
</Project>
